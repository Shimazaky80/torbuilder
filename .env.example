# Local development Supabase project and application origin.
# Use a development/staging project here, never the production project's secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_APP_URL=http://localhost:5173

# Optional, used only by the read-only local schema audit:
# SUPABASE_SERVICE_KEY=your-local-audit-only-service-role-key
